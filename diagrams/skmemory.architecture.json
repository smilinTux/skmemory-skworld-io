  "cards": [
    {
      "dot": "emerald",
      "title": "Sovereign by default",
      "items": [
        "Flat JSON files are the source of truth, SQLite is a derived local index",
        "No cloud dependency and no vendor lock-in required to run the store"
      ]
    },
    {
      "dot": "cyan",
      "title": "Promotion, not curation",
      "items": [
        "Memories move short to mid to long automatically by access count and importance score",
        "Mid-term at 3+ accesses or importance 0.7+, long-term at 10+ accesses or importance 0.9+"
      ]
    },
    {
      "dot": "rose",
      "title": "Tamper-evident",
      "items": [
        "FortifiedMemoryStore seals each memory at creation and keeps an audit log",
        "A PGP-encrypted vaulted variant of the primary backend adds encryption at rest"
      ]
    }
